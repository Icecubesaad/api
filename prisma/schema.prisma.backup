// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  displayName       String?
  firebaseUid       String   @unique
  role              UserRole @default(USER)
  notifPrefs        Json     @default("{}")
  stripeCustomerId  String?  @unique
  tier              SubscriptionTier @default(BASIC)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  projects          Project[]
  notes             Note[]
  dailyLogs         DailyLog[]
  reminders         Reminder[]
  calendarLinks     CalendarLink[]
  uploads           Upload[]
  subscriptions     Subscription[]
  notifications     Notification[]
  auditEvents       AuditEvent[]

  @@map("users")
}

model Project {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notes       Note[]
  dailyLogs   DailyLog[]
  reminders   Reminder[]
  uploads     Upload[]

  @@map("projects")
}

model Note {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  content   String
  type      NoteType
  date      DateTime @default(now())
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  embeddings Embedding[]

  @@map("notes")
}

model DailyLog {
  id              String   @id @default(cuid())
  projectId       String
  date            DateTime
  sourceNoteIds   String[] @default([])
  summary         String
  tasks           String[] @default([])
  hazards         String[] @default([])
  attachments     String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("daily_logs")
}

model Reminder {
  id         String         @id @default(cuid())
  projectId  String
  userId     String
  title      String
  dueAt      DateTime
  recurrence String?
  status     ReminderStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Relations
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model CalendarLink {
  id           String           @id @default(cuid())
  userId       String
  provider     CalendarProvider
  refreshToken String           // Encrypted
  calendarId   String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_links")
}

model Upload {
  id          String       @id @default(cuid())
  projectId   String
  userId      String
  storageKey  String
  mime        String
  bytes       Int
  parsedAt    DateTime?
  parseStatus ParseStatus  @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  embeddings  Embedding[]

  @@map("uploads")
}

model Embedding {
  id          String  @id @default(cuid())
  uploadId    String?
  noteId      String?
  vector      Unsupported("vector(1536)") // pgvector
  chunkText   String
  chunkIndex  Int
  createdAt   DateTime @default(now())

  // Relations
  upload      Upload? @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  note        Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("embeddings")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  status            SubscriptionStatus
  tier              SubscriptionTier
  currentPeriodEnd  DateTime
  limits            Json               @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  channel   NotificationChannel
  title     String
  body      String
  sentAt    DateTime?
  meta      Json              @default("{}")
  createdAt DateTime          @default(now())

  // Relations
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  at        DateTime @default(now())
  meta      Json     @default("{}")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_events")
}

// Enums
enum UserRole {
  USER
  ADMIN
}

enum NoteType {
  VOICE
  TEXT
  AI
}

enum ReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

enum ParseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  UNPAID
}

enum SubscriptionTier {
  BASIC
  PREMIUM
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
}
